# --- Required ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=generate_a_long_random_string_at_least_32_characters

MESH_API_KEY=rsk_your_key_here
MESH_BASE_URL=https://api.meshapi.ai/v1

# --- App ---
DATABASE_URL=sqlite:///./smartreco.db
CHROMA_PERSIST_DIR=./chroma_data
DEBUG=true

# Comma-separated allowed origins for CORS (cookie auth must include the
# exact scheme://host:port the frontend is served from)
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Models (Mesh)
DEFAULT_CHAT_MODEL=tencent/hy3
MAIN_CHAT_MODEL=tencent/hy3
DEFAULT_EMBEDDING_MODEL=sentence-transformers/all-minilm-l6-v2

# Observability (optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=smartreco

# Email / daily digest (optional)
# Code reads SMTP_PASSWORD (not SMTP_PASS) and uses SMTP_SSL on port 465.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# === Rev5 Architecture Keys ===
LLM_ENABLED=true
LLM_DAILY_BUDGET_USD=1.00
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
REC_MIN_EVENTS=5
REC_COOLDOWN_SECONDS=90
CACHE_TTL_SECONDS=900